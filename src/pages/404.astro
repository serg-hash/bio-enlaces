---
import Layout from "../layouts/Layout.astro";
import { localize, site, withBase } from "../config";
import { t } from "../i18n";

const locale = "es";
---

<Layout
  locale={locale}
  title={`404 — ${site.name}`}
  description={localize(site.description, locale)}
  noindex
>
  <main class="not-found" id="contenido">
    <h1>404</h1>
    <p>{t(locale, "notFound")}</p>
    <a href={withBase("/")}>{t(locale, "backHome")}</a>
  </main>
</Layout>
