---
import Layout from "../layouts/Layout.astro";
import {
  site,
  localize,
  parseYouTubeId,
  isYouTubeShort,
  youtubeWatchUrl,
  youtubeEmbedUrl,
  type Locale,
} from "../config";
import { t } from "../i18n";
import { iconSvg, networkLabels } from "../icons";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = localize(site.title, locale) || site.name;
const description = localize(site.description, locale);
const bio = localize(site.bio, locale);
const video = site.featuredVideo;
const videoTitle = video.enabled ? localize(video.title, locale) : "";
const videoId = video.enabled ? parseYouTubeId(video.id) : "";
const videoIsShort = video.enabled && isYouTubeShort(video);
const watchPage = video.enabled ? youtubeWatchUrl(video) : "";

function isExternal(url: string) {
  return /^https?:\/\//i.test(url);
}
---

<Layout locale={locale} title={title} description={description}>
  <header class="profile">
    <div class="avatar-wrap">
      <span class="avatar-ring" aria-hidden="true"></span>
      <img
        class="avatar"
        src={site.avatar}
        alt={`${t(locale, "profileImage")} ${site.name}`}
        width="116"
        height="116"
        decoding="async"
      />
    </div>
    <h1 class="name">{site.name}</h1>
    {site.handle && <p class="handle">{site.handle}</p>}
    <p class="bio">{bio}</p>
  </header>

  {
    site.socials.length > 0 && (
      <nav class="socials" aria-label={t(locale, "follow")}>
        {site.socials.map((social) => {
          const label = social.label
            ? localize(social.label, locale)
            : networkLabels[social.network] || social.network;
          const svg = iconSvg(social.network) || iconSvg("web");
          return (
            <a
              class="social"
              href={social.url}
              target={isExternal(social.url) ? "_blank" : undefined}
              rel={isExternal(social.url) ? "noopener noreferrer" : undefined}
              aria-label={label}
              title={label}
            >
              {svg && <Fragment set:html={svg} />}
            </a>
          );
        })}
      </nav>
    )
  }

  <main id="contenido">
    {
      video.enabled && video.id && (
        <section class="section" aria-labelledby="video-title">
          <h2 class="section-title" id="video-title">
            {t(locale, "featured")}
          </h2>
          <div
            class:list={["video", { short: videoIsShort }]}
            data-youtube={videoId}
            data-embed={youtubeEmbedUrl(videoId)}
            data-title={videoTitle}
          >
            <a class="video-hit" href={watchPage} target="_blank" rel="noopener noreferrer">
              <span class="play" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path fill="currentColor" d="M8 5.2v13.6L19.2 12z" />
                </svg>
              </span>
              <span class="sr-only">{t(locale, "play")}: {videoTitle}</span>
            </a>
            <p class="video-caption">{videoTitle}</p>
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="links-title">
      <h2 class="section-title" id="links-title">{t(locale, "links")}</h2>
      <div class="links">
        {
          site.links.map((link) => {
            const label = localize(link.title, locale);
            const named = iconSvg(link.icon);
            const emoji = !named && link.icon ? link.icon : null;
            const external = isExternal(link.url);
            return (
              <a
                class:list={["link", { featured: Boolean(link.featured) }]}
                href={link.url}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                <span class="link-icon" aria-hidden="true">
                  {named ? <Fragment set:html={named} /> : emoji}
                </span>
                <span class="link-title">{label}</span>
                <span class="link-arrow" aria-hidden="true">↗</span>
              </a>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

{
  video.enabled && video.id && (
    <script>
      document.querySelectorAll<HTMLElement>("[data-youtube]").forEach((box) => {
        const trigger = box.querySelector(".video-hit");
        const embed = box.dataset.embed;
        const title = box.dataset.title || "YouTube";
        if (!trigger || !embed) return;

        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          const iframe = document.createElement("iframe");
          iframe.src = `${embed}?autoplay=1&playsinline=1`;
          iframe.title = title;
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;
          iframe.referrerPolicy = "strict-origin-when-cross-origin";
          trigger.replaceWith(iframe);
        });
      });
    </script>
  )
}
